{
  "expo": {
    "name": "LakbayMate",
    "slug": "lakbaymate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f7a5c",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ph.kitaph.app",
      "intentFilters": [
        {
          "action": "SEND",
          "category": ["DEFAULT"],
          "data": [{ "mimeType": "text/plain" }]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "LakbayMate uses the camera to scan receipts. Photos are read on your phone and never uploaded."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#0f7a5c"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "LakbayMate listens only while you hold the mic, and speech is turned into text on your phone.",
          "speechRecognitionPermission": "LakbayMate turns speech into text on your phone.",
          "androidSpeechServicePackages": [
            "com.google.android.as",
            "com.google.android.tts",
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "description": "LakbayMate, your smart travel companion: talk with locals, read menus, signs and receipts, and keep a live trip budget, with AI that runs on the phone and works offline."
  }
}
